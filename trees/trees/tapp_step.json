{
  "$schema": "./schema.json",
  "id": "tapp_step",
  "title": "T/S Something Else",
  "role": "category",
  "version": "0.5.0",
  "status": "DRAFT",
  "sourceDocs": [
    "DTP TS tickets via Glean, Aug–Oct 2026"
  ],
  "start": "ts_which",
  "nodes": {
    "ts_which": {
      "type": "question",
      "text": "What are you having an issue with?",
      "source": "TS: DTP-111167, DTP-110126, DTP-108736",
      "options": [
        {
          "label": "ATMS/TApp or Mission Setup",
          "issue": "ATMS/TApp or mission setup",
          "short": "ATMS/TApp",
          "next": "ts_recovery"
        },
        {
          "label": "Calibration",
          "short": "Calibration",
          "next": "ts_r_cal"
        },
        {
          "label": "SW Pull",
          "short": "SW Pull",
          "next": "ts_r_sw"
        },
        {
          "label": "Prepare the Aurora Driver",
          "issue": "Prepare the Aurora Driver",
          "short": "Prepare AD",
          "next": "ts_recovery",
          "tools": [
            "tapp"
          ]
        },
        {
          "label": "Enter weight and KPRA",
          "short": "Weight/KPRA",
          "next": "ts_recovery",
          "tools": [
            "tapp"
          ]
        },
        {
          "label": "Diagnostics",
          "issue": "Diagnostics",
          "short": "Diagnostics",
          "next": "ts_recovery",
          "tools": [
            "tapp"
          ]
        },
        {
          "label": "Safety requirements",
          "issue": "Safety requirements",
          "short": "Safety reqs",
          "next": "ts_recovery",
          "tools": [
            "tapp"
          ]
        },
        {
          "label": "Launch",
          "short": "Launch",
          "next": "ts_r_launch",
          "tools": [
            "tapp"
          ]
        },
        {
          "label": "Can't get a Ready State",
          "short": "No ready state",
          "next": "ts_r_ready"
        },
        {
          "label": "Pre-mission or pre-deploy checks",
          "short": "Pre-checks",
          "next": "ts_r_precheck"
        },
        {
          "label": "Power, compute, RSI or ABS light",
          "short": "Power/RSI",
          "next": "ts_r_power"
        },
        {
          "label": "Scout or a module crashed or froze",
          "short": "Scout/module",
          "next": "ts_r_scout",
          "tools": [
            "scout"
          ]
        },
        {
          "label": "Aurora Mobile App: trip, connection or deploy",
          "short": "Mobile App",
          "next": "ts_r_mobile"
        },
        {
          "label": "Not listed: describe it",
          "short": "Not listed",
          "next": "ts_r_other"
        }
      ],
      "help": "Don't see your exact problem? Pick the closest match. If nothing is close, tap Not listed and describe it."
    },
    "ts_r_ready": {
      "type": "route",
      "text": "No ready state",
      "tree": "compute_ready"
    },
    "ts_r_other": {
      "type": "route",
      "text": "Something else",
      "tree": "other"
    },
    "ts_r_precheck": {
      "type": "route",
      "text": "Pre-mission or pre-deploy checks",
      "tree": "precheck"
    },
    "ts_r_power": {
      "type": "route",
      "text": "Power, compute, RSI or ABS light",
      "tree": "power_hw"
    },
    "ts_r_scout": {
      "type": "route",
      "text": "Scout or module problem",
      "tree": "scout_issue"
    },
    "ts_r_mobile": {
      "type": "route",
      "text": "Aurora Mobile App",
      "tree": "mobile_app"
    },
    "ts_r_sw": {
      "type": "route",
      "text": "Software download",
      "tree": "sw_pull"
    },
    "ts_r_cal": {
      "type": "route",
      "text": "Calibration",
      "tree": "calibration"
    },
    "ts_r_launch": {
      "type": "route",
      "text": "Launch",
      "tree": "launch"
    },
    "ts_recovery": {
      "variants": [
        {
          "when": {
            "platform": "peterbilt"
          },
          "help": "TApp errors carry an instruction (RETRY_STEP, RETRY_TASK, DO_NOT_RETRY) and a recovery action (RESET_PBT, REQUEST_SUPPORT, GET_TECHNICAL_SUPPORT). Follow what it says."
        }
      ],
      "type": "question",
      "text": "What recovery action does the error show?",
      "help": "TApp errors carry an instruction (RETRY_STEP, RETRY_TASK, DO_NOT_RETRY) and a recovery action (REQUEST_SUPPORT, GET_TECHNICAL_SUPPORT). Follow what it says.",
      "source": "TS: DTP-111734, DTP-108736, DTP-110239",
      "options": [
        {
          "label": "Retry step / retry task",
          "short": "Retry",
          "next": "ts_retry"
        },
        {
          "label": "Reset PBT",
          "short": "Reset PBT",
          "platforms": [
            "peterbilt"
          ],
          "next": "ts_pbt"
        },
        {
          "label": "Request support / get technical support",
          "short": "Support",
          "next": "ts_esc"
        },
        {
          "label": "Do not retry, or nothing shown",
          "short": "No retry",
          "next": "ts_esc"
        }
      ]
    },
    "ts_retry": {
      "type": "action",
      "authorizedRole": "VO",
      "short": "Retried",
      "text": "Retry the step once",
      "steps": [
        "Retry the failed step from TApp, once."
      ],
      "source": "TS: DTP-108736",
      "next": "ts_esc"
    },
    "ts_pbt": {
      "type": "action",
      "authorizedRole": "VO",
      "short": "PBT reset",
      "text": "Do the PBT reset TApp is asking for",
      "steps": [
        "Perform the PBT reset per [SOP](https://sites.google.com/aurora.tech/procedures/home-v2).",
        "Retry the step."
      ],
      "source": "TS: DTP-111734, DTP-108520",
      "next": "ts_esc",
      "help": "After a PBT reset the failed task may still need a reset, which a VRE does remotely."
    },
    "ts_esc": {
      "phrase": "TApp step failed, {issue}",
      "details": [
        "Screenshot: the TApp error with its instruction and recovery action (for example RETRY_STEP or REQUEST_SUPPORT)."
      ],
      "type": "terminal",
      "terminal": "ESCALATE_VRE",
      "text": "Operator-level TApp steps are used up. Open a TS ticket and paste the handoff.",
      "source": "ReadyPath",
      "handoffNote": "Likely request from past tickets: reset the failed task. Errors seen: ACTUAL_SOFTWARE_NOT_OF_RELEASE (ticket/software mismatch), SOFTWARE_DEPLOY_ONGOING (TApp thinks a deploy is still running)."
    }
  }
}